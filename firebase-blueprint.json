{
  "entities": {
    "Alert": {
      "title": "Alert",
      "description": "Security alerts generated by the AI anomaly detection system.",
      "type": "object",
      "properties": {
        "threat_type": { "type": "string", "description": "Type of threat (e.g., Brute Force, DDoS, Port Scan)" },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "source_ip": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Blocked", "Resolved"] },
        "details": { "type": "string" }
      },
      "required": ["threat_type", "severity", "source_ip", "timestamp", "status"]
    },
    "TrafficLog": {
      "title": "Traffic Log",
      "description": "Logs of network traffic packets.",
      "type": "object",
      "properties": {
        "source_ip": { "type": "string" },
        "destination_ip": { "type": "string" },
        "protocol": { "type": "string" },
        "packet_size": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "connection_count": { "type": "number" }
      },
      "required": ["source_ip", "destination_ip", "protocol", "packet_size", "timestamp"]
    },
    "BlockedIP": {
      "title": "Blocked IP",
      "description": "IP addresses that have been blocked by the administrator.",
      "type": "object",
      "properties": {
        "ip_address": { "type": "string" },
        "blocked_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      },
      "required": ["ip_address", "blocked_at"]
    }
  },
  "firestore": {
    "alerts": {
      "schema": "Alert",
      "description": "Collection of security alerts."
    },
    "traffic_logs": {
      "schema": "TrafficLog",
      "description": "Collection of network traffic logs."
    },
    "blocked_ips": {
      "schema": "BlockedIP",
      "description": "Collection of blocked IP addresses."
    }
  }
}
